    affiliation: Wei's Lab
    orcid: https://orcid.org/0009-0009-0455-9294
version: 0.1.0
date-released: "2026-09-08"
repository-code: "https://github.com/Wei-s-lab/dempster-shafer-library"
url: "https://github.com/Wei-s-lab/dempster-shafer-library"
keywords:
  - evidential theory
  - Dempster-Shafer
  - belief functions
  - C++
